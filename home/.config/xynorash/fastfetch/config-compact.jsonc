// Fastfetch config — XYNORASH theme, compact: no logo, for terminals under 100 columns
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": null,
  "display": {
    "separator": " → ",
    "color": { "keys": "38;2;170;0;255", "title": "38;2;0;229;255" }
  },
  "modules": [
    { "type": "title", "color": { "user": "38;2;0;229;255", "at": "38;2;100;100;180", "host": "38;2;170;0;255" } },
    { "type": "separator", "string": "──────────────────────────────" },
    { "type": "os",       "key": "󰍲 OS",     "keyColor": "38;2;170;0;255" },
    { "type": "kernel",   "key": "󰍛 Kernel", "keyColor": "38;2;170;0;255" },
    { "type": "uptime",   "key": "󰅐 Uptime", "keyColor": "38;2;0;229;255" },
    { "type": "shell",    "key": "󰍛 Shell",  "keyColor": "38;2;0;229;255" },
    { "type": "cpu",      "key": "󰍛 CPU",    "keyColor": "38;2;255;170;0" },
    { "type": "gpu",      "key": "󰢮 GPU",    "keyColor": "38;2;255;100;50" },
    { "type": "memory",   "key": "󰍛 RAM",    "keyColor": "38;2;170;0;255", "format": "{1} / {2} ({3})" },
    { "type": "disk",     "key": "󰋊 /",      "keyColor": "38;2;238;0;238", "folders": "/", "format": "{1} / {2} ({3})" },
    { "type": "colors", "symbol": "circle" }
  ]
}
