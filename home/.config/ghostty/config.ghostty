# Palette is regenerated by noctalia's ghostty template on every theme change.
theme = noctalia

font-family = JetBrainsMono Nerd Font Mono
font-size = 7.5

# Roomy padding — Omarchy terminals breathe.
window-padding-x = 14
window-padding-y = 14
window-padding-balance = true

# Glassy panel, matching the bar's translucency.
background-opacity = 0.92
background-blur = true

cursor-style = block
mouse-hide-while-typing = true
