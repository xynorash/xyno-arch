#!/usr/bin/env python3
"""xyno-kbd-guard: detect (and optionally filter) key-switch chatter on a USB keyboard.

Chatter = a key that is released and then "pressed" again a few milliseconds later without the
user doing anything. A human cannot re-press a key within ~30 ms of releasing it, so such presses
are false.

  monitor (default)  Read-only. Counts false repeats, logs them to the journal once a minute,
                     writes /run/xyno-kbd-guard.json, and sends a desktop notification when
                     chatter shows up. Never touches the keyboard's input path.
  filter             Exclusive-grabs the real keyboard, drops the false presses, and re-emits
                     everything else through a uinput clone. Safety: runs under a systemd
                     watchdog, and the kernel releases the grab the instant this process dies.

Only stdlib; talks to evdev/uinput through raw ioctls.
"""
import argparse
import errno
import fcntl
import json
import os
import select
import signal
import socket
import struct
import subprocess
import sys
import time

EV_SYN, EV_KEY, EV_MSC, EV_LED, EV_REP = 0, 1, 4, 17, 20
SYN_REPORT = 0
EVENT = struct.Struct("llHHi")  # struct input_event on 64-bit Linux (24 bytes)


def _ioc(direction, kind, nr, size):
    return (direction << 30) | (size << 16) | (ord(kind) << 8) | nr


EVIOCGRAB = _ioc(1, "E", 0x90, 4)
EVIOCGID = _ioc(2, "E", 0x02, 8)


def eviocgbit(ev, length):
    return _ioc(2, "E", 0x20 + ev, length)


UI_DEV_CREATE = _ioc(0, "U", 1, 0)
UI_DEV_SETUP = _ioc(1, "U", 3, 92)
UI_SET_EVBIT = _ioc(1, "U", 100, 4)
UI_SET_KEYBIT = _ioc(1, "U", 101, 4)
UI_SET_MSCBIT = _ioc(1, "U", 104, 4)
UI_SET_LEDBIT = _ioc(1, "U", 105, 4)

STATE_FILE = "/run/xyno-kbd-guard.json"


def log(msg):
    print(msg, flush=True)


def sd_notify(msg):
    addr = os.environ.get("NOTIFY_SOCKET")
    if not addr:
        return
    if addr[0] == "@":
        addr = "\0" + addr[1:]
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        s.connect(addr)
        s.send(msg.encode())
        s.close()
    except OSError:
        pass


def find_event_node(name):
    try:
        text = open("/proc/bus/input/devices").read()
    except OSError:
        return None
    for block in text.split("\n\n"):
        if 'Name="%s"' % name in block:
            for line in block.splitlines():
                if line.startswith("H: Handlers="):
                    for h in line.split():
                        if h.startswith("event"):
                            return "/dev/input/" + h
    return None


def supported_bits(fd, ev, nbytes):
    buf = bytearray(nbytes)
    fcntl.ioctl(fd, eviocgbit(ev, nbytes), buf)
    return [i * 8 + b for i, byte in enumerate(buf) for b in range(8) if byte >> b & 1]


def make_uinput(real_fd, name):
    """Create a uinput keyboard that mirrors the capabilities of the real one."""
    ufd = os.open("/dev/uinput", os.O_RDWR | os.O_NONBLOCK)
    ident = bytearray(8)
    fcntl.ioctl(real_fd, EVIOCGID, ident)
    for ev in (EV_SYN, EV_KEY, EV_MSC, EV_LED, EV_REP):
        fcntl.ioctl(ufd, UI_SET_EVBIT, ev)
    for k in supported_bits(real_fd, EV_KEY, 96):
        fcntl.ioctl(ufd, UI_SET_KEYBIT, k)
    for m in supported_bits(real_fd, EV_MSC, 1):
        fcntl.ioctl(ufd, UI_SET_MSCBIT, m)
    for l in supported_bits(real_fd, EV_LED, 2):
        fcntl.ioctl(ufd, UI_SET_LEDBIT, l)
    setup = bytes(ident) + name.encode()[:79].ljust(80, b"\0") + struct.pack("I", 0)
    fcntl.ioctl(ufd, UI_DEV_SETUP, setup)
    fcntl.ioctl(ufd, UI_DEV_CREATE)
    return ufd


class Guard:
    def __init__(self, args):
        self.a = args
        self.rfd = None
        self.ufd = None
        self.buf = b""
        self.frame = []
        self.last_rel = {}
        self.suppressed = set()
        self.presses = 0
        self.bounces = 0
        self.win_bounces = 0
        self.win_keys = {}
        self.win_start = time.time()
        self.last_notify = 0.0
        self.running = True

    # -- device handling -------------------------------------------------------------------
    def open_real(self):
        node = self.a.device or find_event_node(self.a.name)
        if not node:
            return False
        flags = os.O_RDWR if self.a.mode == "filter" else os.O_RDONLY
        try:
            self.rfd = os.open(node, flags | os.O_NONBLOCK)
            if self.a.mode == "filter":
                if self.ufd is None:
                    self.ufd = make_uinput(self.rfd, self.a.name + " (debounced)")
                    time.sleep(0.4)  # let udev/compositors pick the new device up
                fcntl.ioctl(self.rfd, EVIOCGRAB, 1)
        except OSError as e:
            log("cannot open %s: %s" % (node, e))
            self.close_real()
            return False
        self.buf = b""
        self.frame = []
        log("%s: watching %s (%s mode, threshold %d ms)" % (self.a.name, node, self.a.mode, self.a.threshold_ms))
        return True

    def close_real(self):
        if self.rfd is not None:
            try:
                os.close(self.rfd)  # closing releases the exclusive grab
            except OSError:
                pass
        self.rfd = None

    # -- event processing ------------------------------------------------------------------
    def handle_frame(self, frame):
        """Returns the frame to forward (list of tuples) after filtering; counts chatter."""
        thr = self.a.threshold_ms / 1000.0
        drop = set()
        for i, (t, typ, code, val) in enumerate(frame):
            if typ != EV_KEY:
                continue
            if val == 1:
                lr = self.last_rel.get(code)
                if lr is not None and 0 <= (t - lr) < thr:
                    self.suppressed.add(code)
                    self.bounces += 1
                    self.win_bounces += 1
                    self.win_keys[code] = self.win_keys.get(code, 0) + 1
                    drop.add(i)
                    if i > 0 and frame[i - 1][1] == EV_MSC:
                        drop.add(i - 1)
                else:
                    self.suppressed.discard(code)
                    self.presses += 1
            elif val == 0:
                self.last_rel[code] = t  # physical release, even if it ends a suppressed bounce
                if code in self.suppressed:
                    self.suppressed.discard(code)
                    drop.add(i)
                    if i > 0 and frame[i - 1][1] == EV_MSC:
                        drop.add(i - 1)
            elif val == 2:
                drop.add(i)  # the uinput clone generates its own kernel autorepeat
        out = [e for i, e in enumerate(frame) if i not in drop]
        if all(e[1] == EV_SYN for e in out):
            return []
        return out

    def pump_real(self):
        try:
            data = os.read(self.rfd, EVENT.size * 64)
        except BlockingIOError:
            return True
        except OSError as e:
            if e.errno in (errno.ENODEV, errno.EIO):
                log("keyboard went away (%s); waiting for it to come back" % e)
                self.close_real()
                return False
            raise
        if not data:
            self.close_real()
            return False
        self.buf += data
        while len(self.buf) >= EVENT.size:
            sec, usec, typ, code, val = EVENT.unpack(self.buf[:EVENT.size])
            self.buf = self.buf[EVENT.size:]
            self.frame.append((sec + usec / 1e6, typ, code, val))
            if typ == EV_SYN and code == SYN_REPORT:
                out = self.handle_frame(self.frame)
                self.frame = []
                if self.a.mode == "filter" and out:
                    os.write(self.ufd, b"".join(EVENT.pack(0, 0, t, c, v) for _, t, c, v in out))
        return True

    def pump_leds(self):
        """LED writes (NumLock/CapsLock) arrive on the clone; pass them to the real keyboard."""
        try:
            data = os.read(self.ufd, EVENT.size * 16)
        except BlockingIOError:
            return
        for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
            _, _, typ, code, val = EVENT.unpack(data[i:i + EVENT.size])
            if typ in (EV_LED, EV_SYN) and self.rfd is not None:
                try:
                    os.write(self.rfd, EVENT.pack(0, 0, typ, code, val))
                except OSError:
                    pass

    # -- reporting -------------------------------------------------------------------------
    def tick(self):
        now = time.time()
        if now - self.win_start < self.a.window_s:
            return
        n = self.win_bounces
        if n:
            keys = ", ".join("0x%x x%d" % (k, v) for k, v in sorted(self.win_keys.items(), key=lambda kv: -kv[1])[:6])
            log("chatter: %d false repeat(s) in the last minute (keycodes: %s); %d presses total, %d false total"
                % (n, keys, self.presses, self.bounces))
            if n >= self.a.notify_min and not self.a.no_notify and now - self.last_notify > self.a.notify_gap:
                self.last_notify = now
                self.notify("Keyboard chatter detected",
                            "%d false key repeats in the last minute (%s mode). "
                            "To filter them: sudo systemctl enable --now xyno-kbd-debounce" % (n, self.a.mode))
        self.write_state(n)
        self.win_bounces = 0
        self.win_keys = {}
        self.win_start = now

    def write_state(self, last_min):
        st = {"ts": int(time.time()), "mode": self.a.mode, "presses_total": self.presses,
              "bounces_total": self.bounces, "bounces_last_min": last_min, "threshold_ms": self.a.threshold_ms}
        try:
            tmp = STATE_FILE + ".tmp"
            with open(tmp, "w") as f:
                json.dump(st, f)
            os.replace(tmp, STATE_FILE)
        except OSError:
            pass

    def notify(self, title, body):
        user = self.a.notify_user
        bus = "/run/user/%d/bus" % int(subprocess.run(["id", "-u", user], capture_output=True, text=True).stdout or 0)
        if not os.path.exists(bus):
            return
        subprocess.run(["runuser", "-u", user, "--", "env", "DBUS_SESSION_BUS_ADDRESS=unix:path=" + bus,
                        "notify-send", "-u", "normal", "-a", "xyno-kbd-guard", title, body],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)

    # -- main loop -------------------------------------------------------------------------
    def run(self):
        signal.signal(signal.SIGTERM, lambda *_: setattr(self, "running", False))
        signal.signal(signal.SIGINT, lambda *_: setattr(self, "running", False))
        sd_notify("READY=1")
        while self.running:
            sd_notify("WATCHDOG=1")
            if self.rfd is None:
                if not self.open_real():
                    time.sleep(2)
                    continue
            fds = [self.rfd] + ([self.ufd] if self.ufd is not None else [])
            ready, _, _ = select.select(fds, [], [], 1.0)
            for fd in ready:
                if fd == self.rfd:
                    self.pump_real()
                elif fd == self.ufd:
                    self.pump_leds()
            self.tick()
        self.close_real()
        if self.ufd is not None:
            os.close(self.ufd)
        log("stopped; keyboard released")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--name", default="SEMICO USB Keyboard", help="exact input device name to watch")
    p.add_argument("--device", help="explicit /dev/input/eventN (overrides --name lookup)")
    p.add_argument("--mode", choices=("monitor", "filter"), default="monitor")
    p.add_argument("--threshold-ms", type=int, default=30, help="a re-press this soon after release is chatter")
    p.add_argument("--notify-user", default="xynorash")
    p.add_argument("--notify-min", type=int, default=5, help="false repeats per minute that trigger a notification")
    p.add_argument("--notify-gap", type=int, default=1800, help="min seconds between notifications")
    p.add_argument("--no-notify", action="store_true")
    p.add_argument("--window-s", type=int, default=60, help="reporting window in seconds")
    args = p.parse_args()
    Guard(args).run()


if __name__ == "__main__":
    sys.exit(main())
