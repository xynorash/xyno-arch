#!/bin/bash
# xyno-greeter: graphical greeter for greetd, ReGreet inside Cage, themed after the profile README
# (/etc/greetd/regreet.toml + regreet.css, background /usr/share/backgrounds/xynorash-edge.png).
#
# Safety net: if the graphical greeter dies within a few seconds of starting (no human can have
# logged in by then), fall back to the previous text-mode tuigreet so a login screen always exists.
export WLR_NO_HARDWARE_CURSORS=1
export GSK_RENDERER=cairo   # software GTK rendering: no GPU-driver surprises in the login path

start=$SECONDS
cage -s -d -m last -- regreet -c /etc/greetd/regreet.toml -s /etc/greetd/regreet.css
rc=$?

if (( SECONDS - start < 5 )); then
  logger -t xyno-greeter "cage/regreet exited rc=$rc after $((SECONDS - start))s; falling back to tuigreet"
  exec tuigreet --background matrix --matrix-colors '#7dcfff,#7aa2f7,#bb9af7' --matrix-length 6,20 --theme 'border=lightblue;title=lightblue;text=white;time=lightblue;greet=lightmagenta;prompt=lightcyan;input=white;action=darkgray;button=lightmagenta;container=black' --time --time-format '%A %d %B  ·  %H:%M' --greeting 'xynogamer' --greet-align center --asterisks --asterisks-char '•' --remember --remember-session --user-menu --user-menu-min-uid 1000 --window-padding 2 --container-padding 2 --prompt-padding 1 --width 60 --power-shutdown 'systemctl poweroff' --power-reboot 'systemctl reboot' --cmd start-hyprland
fi
exit 0
