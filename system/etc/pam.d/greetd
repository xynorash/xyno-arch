#%PAM-1.0
auth       required     pam_securetty.so
auth       requisite    pam_nologin.so
auth       include      system-local-login
# unlock the login keyring with the login password; skip the greeter account itself (HOME=/, cannot create keyrings)
auth       [success=1 default=ignore] pam_succeed_if.so quiet user = greeter
auth       optional     pam_gnome_keyring.so
account    include      system-local-login
session    include      system-local-login
session    [success=1 default=ignore] pam_succeed_if.so quiet user = greeter
session    optional     pam_gnome_keyring.so auto_start
