[Unit]
Description=Keyboard debounce filter (OPT-IN: grabs the keyboard, drops false repeats, re-emits the rest)
# Replaces the read-only monitor while enabled (the filter also counts, logs and notifies).
Conflicts=xyno-kbd-guard.service
After=systemd-udevd.service
Before=greetd.service

[Service]
# Safety: if this process hangs or dies the kernel releases the grab and the raw keyboard returns.
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/xyno-kbd-guard --mode filter
WatchdogSec=10
Restart=always
RestartSec=1
ProtectSystem=strict
ReadWritePaths=/run
PrivateTmp=true

[Install]
WantedBy=multi-user.target
