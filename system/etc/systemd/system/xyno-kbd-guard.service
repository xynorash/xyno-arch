[Unit]
Description=Keyboard chatter monitor (read-only: counts false key repeats, notifies on chatter)
After=systemd-udevd.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/xyno-kbd-guard --mode monitor
WatchdogSec=15
Restart=always
RestartSec=2
ProtectSystem=strict
ReadWritePaths=/run
PrivateTmp=true

[Install]
WantedBy=multi-user.target
